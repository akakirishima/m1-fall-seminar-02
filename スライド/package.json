{
  "name": "m1-seminar-02",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "slidev seminar.md --port 3032",
    "build": "slidev build seminar.md",
    "export": "powershell.exe -NoProfile -File scripts/export_native_pptx.ps1",
    "export:pdf": "slidev export seminar.md --format pdf --output exports/seminar-02.pdf",
    "export:png": "slidev export seminar.md --format png --output exports/png"
  },
  "engines": {
    "node": "^24.22.0"
  },
  "overrides": {
    "@shikijs/vitepress-twoslash": "4.4.3",
    "floating-vue": "5.2.2"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "pdf-lib": "1.17.1",
    "playwright-chromium": "1.64.1",
    "vue": "3.5.44"
  },
  "allowScripts": {
    "playwright-chromium@1.64.1": true,
    "fsevents@2.3.3": true
  }
}
