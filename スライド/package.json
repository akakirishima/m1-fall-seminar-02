{
  "name": "neonatal-research-midterm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --port 3031",
    "build": "slidev build slides.md",
    "export": "slidev export slides.md --format pptx-editable --output exports/midterm-editable.pptx",
    "export:pdf": "slidev export slides.md --format pdf --output exports/midterm.pdf",
    "export:png": "slidev export slides.md --format png --output exports/png"
  },
  "engines": {
    "node": "^24.22.0"
  },
  "overrides": {
    "@shikijs/vitepress-twoslash": "4.4.3",
    "floating-vue": "5.2.2"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "pdf-lib": "1.17.1",
    "playwright-chromium": "1.64.1",
    "vue": "3.5.44"
  },
  "allowScripts": {
    "playwright-chromium@1.64.1": true,
    "fsevents@2.3.3": true
  }
}
